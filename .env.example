SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite

# For PostgreSQL, set DB_ENGINE=postgresql and fill in these values.
DB_NAME=mydigitallife
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Optional, comma-separated HTTPS origins when DEBUG=False.
# CSRF_TRUSTED_ORIGINS=https://your-domain.example