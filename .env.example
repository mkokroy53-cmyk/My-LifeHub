SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite

# For PostgreSQL, set DB_ENGINE=postgresql and fill in these values.
DB_NAME=mydigitallife
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Optional, comma-separated HTTPS origins when DEBUG=False.
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Production database (Render provides this automatically from the managed DB).
# When set, it takes precedence over the DB_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Persistent storage for private PDF uploads (required on Render: the local disk is
# ephemeral and is wiped on every restart/redeploy). Set AWS_STORAGE_BUCKET_NAME to
# enable S3-compatible object storage; leave it blank to store files on local disk.
# AWS_STORAGE_BUCKET_NAME=my-lifehub-private
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com